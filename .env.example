# Copy to .env.local and fill in. Never commit real values. All server-only.

# --- Supabase: Project Settings -> API. No NEXT_PUBLIC_ prefix. ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Sarvam API key: used for text-to-speech and outbound calls ---
SARVAM_API_KEY=

# --- Sarvam Voice Agents, from Deploy with code -> Instant outbound ---
# Organisation and workspace ids from the outbound URL
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The agent (app) id and its published version number
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_APP_TYPE=agent
# Telephony connection id and the agent's phone number in E.164 (+91...)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# Long random string; Sarvam sends it back as ?token= on the webhook URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SARVAM_WEBHOOK_SECRET=

# Public https URL of this app, so Sarvam can reach the webhook.
# Production: https://your-app.vercel.app   Local: your ngrok or cloudflared URL
APP_BASE_URL=

# simulate (default): no real calls, results arrive after a few seconds.
# live: real calls through Sarvam (CALL_MODE is the kill switch: set simulate to stop all real calls).
CALL_MODE=simulate
# Optional. Empty = open mode: any valid number added with consent can be called.
# Set it (comma separated E.164) to restrict live calls to these numbers only.
CALL_ALLOWLIST=
# Caps on call attempts per IST day: across all visitors, and per workspace
MAX_CALLS_PER_DAY=40
MAX_CALLS_PER_WORKSPACE_PER_DAY=8
# Family members per workspace
MAX_PEOPLE_PER_WORKSPACE=5

# --- Scheduler: Upstash QStash (console.upstash.com -> QStash -> Request builder / Signing keys) ---
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Local only: lets `pnpm tick` run the scheduler without a QStash signature. Ignored in production.
CRON_DEV_SECRET=

# --- Email alerts (optional): resend.com. Both must be set to send email. ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Yaad <alerts@yourdomain.com>"
ALERT_FROM_EMAIL=

# Copy to .env.local and fill in. Never commit real values. All server-only.

# --- Supabase: Project Settings -> API. No NEXT_PUBLIC_ prefix. ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Sarvam API key: used for text-to-speech and outbound calls ---
SARVAM_API_KEY=

# --- Sarvam Voice Agents, from Deploy with code -> Instant outbound ---
# Organisation and workspace ids from the outbound URL
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The agent (app) id and its published version number
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_APP_TYPE=agent
# Telephony connection id and the agent's phone number in E.164 (+91...)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# Long random string; Sarvam sends it back as ?token= on the webhook URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SARVAM_WEBHOOK_SECRET=

# Public https URL of this app, so Sarvam can reach the webhook.
# Production: https://your-app.vercel.app   Local: your ngrok or cloudflared URL
APP_BASE_URL=

# simulate (default): no real calls, results arrive after a few seconds.
# live: real calls through Sarvam, only to numbers in CALL_ALLOWLIST.
CALL_MODE=simulate
# Comma separated E.164 numbers that live mode may call, e.g. +919876543210,+919812345678
CALL_ALLOWLIST=
# Safety cap on call attempts per IST day, across all workspaces
MAX_CALLS_PER_DAY=40
